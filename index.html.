
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MOVIETOK | Discover Movies</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  background:#090b12;
  color:white;
  font-family:Arial,sans-serif;
}
header{
  padding:22px 6%;
  display:flex;
  justify-content:space-between;
  align-items:center;
  background:#10131d;
}
.logo{font-size:27px;font-weight:900;color:#ff375f}
nav{color:#aaa;font-size:13px}
.hero{
  padding:55px 6%;
  background:linear-gradient(120deg,#242039,#111522);
}
.hero h1{font-size:38px;margin:0 0 12px}
.hero p{color:#bbb}
.search{
  display:flex;
  gap:8px;
  margin-top:25px;
}
input{
  flex:1;
  min-width:0;
  padding:15px;
  border:1px solid #444;
  border-radius:8px;
  background:#090b12;
  color:white;
  font-size:15px;
}
button{
  background:#ff375f;
  color:white;
  border:0;
  border-radius:8px;
  padding:0 20px;
  font-weight:bold;
}
main{padding:25px 6%}
h2{font-size:22px}
.movies{
  display:grid;
  grid-template-columns:repeat(auto-fill,minmax(135px,1fr));
  gap:18px;
}
.movie{min-width:0}
.movie img{
  width:100%;
  aspect-ratio:2/3;
  object-fit:cover;
  border-radius:10px;
  background:#202432;
}
.movie h3{font-size:14px;margin:9px 0 5px}
.movie p{font-size:12px;color:#aaa;margin:0}
#status{color:#aaa;margin:20px 0}
footer{
  text-align:center;
  padding:30px;
  color:#777;
  font-size:12px;
}
</style>
</head>
<body>

<header>
  <div class="logo">MOVIETOK 🎬</div>
  <nav>DISCOVER MOVIES</nav>
</header>

<section class="hero">
  <h1>Find Your Next Movie.</h1>
  <p>Explore trending movies and discover your favourites.</p>
  <div class="search">
    <input id="searchInput" placeholder="Search movies...">
    <button onclick="searchMovies()">Search</button>
  </div>
</section>

<main>
  <h2 id="heading">🔥 Trending Movies</h2>
  <div id="status">Loading movies...</div>
  <div class="movies" id="movies"></div>
</main>

<footer>© 2026 MOVIETOK. Discover your next favourite movie.</footer>

<script>
const movies = document.getElementById("movies");
const statusText = document.getElementById("status");
const heading = document.getElementById("heading");

async function loadMovies(query = "") {
  statusText.textContent = "Loading movies...";
  movies.innerHTML = "";

  try {
    const url = query
      ? "/api/movies?query=" + encodeURIComponent(query)
      : "/api/movies?category=trending";

    const response = await fetch(url);

    if (!response.ok) throw new Error("Could not load movies");

    const data = await response.json();

    if (!data.results || data.results.length === 0) {
      statusText.textContent = "No movies found.";
      return;
    }

    statusText.textContent = "";

    data.results.forEach(movie => {
      const poster = movie.poster_path
        ? "https://image.tmdb.org/t/p/w500" + movie.poster_path
        : "";

      const card = document.createElement("div");
      card.className = "movie";

      const img = document.createElement("img");
      img.src = poster;
      img.alt = movie.title || "Movie poster";
      img.loading = "lazy";

      const title = document.createElement("h3");
      title.textContent = movie.title || "Untitled";

      const details = document.createElement("p");
      details.textContent =
        "⭐ " + (movie.vote_average?.toFixed(1) || "N/A") +
        " · " + (movie.release_date || "Unknown");

      card.append(img, title, details);
      movies.appendChild(card);
    });

  } catch (error) {
    statusText.textContent =
      "Unable to load movies. Please try again later.";
  }
}

function searchMovies() {
  const query = document.getElementById("searchInput").value.trim();

  if (!query) {
    heading.textContent = "🔥 Trending Movies";
    loadMovies();
    return;
  }

  heading.textContent = "🔎 Search Results";
  loadMovies(query);
}

document.getElementById("searchInput")
  .addEventListener("keydown", event => {
    if (event.key === "Enter") searchMovies();
  });

loadMovies();
</script>

</body>
</html>
